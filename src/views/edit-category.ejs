<%- include("partials/header") %>

<main>
  <h1><%= title %></h1>

  <% if (errors.length > 0) { %>
    <div role="alert">
      <h2>Please correct the following errors:</h2>
      <ul>
        <% errors.forEach((error) => { %>
          <li><%= error.msg %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <form
    action="/edit-category/<%= data.category_id %>"
    method="POST"
  >
    <div>
      <label for="name">Category Name</label>
      <input
        type="text"
        id="name"
        name="name"
        value="<%= data.name || '' %>"
        required
        maxlength="100"
      >
    </div>

    <button type="submit">Update Category</button>
  </form>

  <p>
    <a href="/category/<%= data.category_id %>">Cancel</a>
  </p>
</main>

<%- include("partials/footer") %>