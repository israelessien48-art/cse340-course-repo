<%- include("partials/header") %>

<h1>Dashboard</h1>

<p>Welcome to your dashboard, <%= user.name %>.</p>

<p>
  You are logged in as:
  <strong><%= user.role_id === 2 ? "Administrator" : "User" %></strong>
</p>

<p>
  Use the navigation above to access the parts of the CSE 340 Service Projects site available to you.
</p>

<h2>My Volunteer Projects</h2>

<% if (volunteerProjects.length > 0) { %>
  <ul>
    <% volunteerProjects.forEach((project) => { %>
      <li>
        <a href="/project/<%= project.project_id %>">
          <%= project.title %>
        </a>
        — <%= project.formatted_date %> at <%= project.location %>
        <a href="/project/<%= project.project_id %>/unvolunteer">
          Remove Volunteer
        </a>
      </li>
    <% }) %>
  </ul>
<% } else { %>
  <p>You are not volunteering for any projects yet.</p>
<% } %>

<%- include("partials/footer") %>
