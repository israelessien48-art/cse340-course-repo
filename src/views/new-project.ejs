<%- include("partials/header") %>

<main>
  <h1><%= title %></h1>

  <% if (errors.length > 0) { %>
    <div role="alert">
      <h2>Please correct the following errors:</h2>
      <ul>
        <% errors.forEach((error) => { %>
          <li><%= error.msg %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <form action="/new-project" method="POST">
    <div>
      <label for="organization_id">Organization</label>
      <select
        id="organization_id"
        name="organization_id"
        required
      >
        <option value="">Select an organization</option>

        <% organizations.forEach((organization) => { %>
          <option
            value="<%= organization.organization_id %>"
            <%= String(data.organization_id || "") === String(organization.organization_id) ? "selected" : "" %>
          >
            <%= organization.name %>
          </option>
        <% }) %>
      </select>
    </div>

    <div>
      <label for="title">Project Title</label>
      <input
        type="text"
        id="title"
        name="title"
        value="<%= data.title || '' %>"
        required
        minlength="3"
        maxlength="150"
      >
    </div>

    <div>
      <label for="description">Description</label>
      <textarea
        id="description"
        name="description"
        required
      ><%= data.description || '' %></textarea>
    </div>

    <div>
      <label for="location">Location</label>
      <input
        type="text"
        id="location"
        name="location"
        value="<%= data.location || '' %>"
        required
        maxlength="255"
      >
    </div>

    <div>
      <label for="date">Project Date</label>
      <input
        type="date"
        id="date"
        name="date"
        value="<%= data.date || '' %>"
        required
      >
    </div>

    <button type="submit">Create Project</button>
  </form>

  <p>
    <a href="/projects">Cancel</a>
  </p>
</main>

<%- include("partials/footer") %>