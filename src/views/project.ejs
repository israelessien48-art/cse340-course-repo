<%- include("partials/header") %>

<main>
  <h1><%= project.title %></h1>

  <p><%= project.description %></p>

  <p>
    <strong>Date:</strong>
    <%= project.formatted_date %>
  </p>

  <p>
    <strong>Location:</strong>
    <%= project.location %>
  </p>

  <p>
    <strong>Organization:</strong>
    <a href="/organization/<%= project.organization_id %>">
      <%= project.organization_name %>
    </a>
  </p>

  <p>
    <a href="/edit-project/<%= project.project_id %>">
      Edit Project
    </a>
  </p>

  <p>
    <a href="/project/<%= project.project_id %>/categories">
      Update Categories
    </a>
  </p>

  <h2>Categories</h2>

  <% if (project.categories.length > 0) { %>
    <ul>
      <% project.categories.forEach((category) => { %>
        <li>
          <a href="/category/<%= category.category_id %>">
            <%= category.name %>
          </a>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <p>This project has no categories.</p>
  <% } %>
</main>

<%- include("partials/footer") %>