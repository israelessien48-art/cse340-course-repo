<%- include("partials/header") %>

<main>
  <h1><%= title %></h1>

  <% if (errors.length > 0) { %>
    <div role="alert">
      <h2>Please correct the following errors:</h2>
      <ul>
        <% errors.forEach((error) => { %>
          <li><%= error.msg %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <form
    action="/edit-organization/<%= data.organization_id %>"
    method="POST"
  >
    <div>
      <label for="name">Organization Name</label>
      <input
        type="text"
        id="name"
        name="name"
        value="<%= data.name || '' %>"
        required
        minlength="3"
        maxlength="150"
      >
    </div>

    <div>
      <label for="description">Description</label>
      <textarea
        id="description"
        name="description"
        required
      ><%= data.description || '' %></textarea>
    </div>

    <div>
      <label for="contact_email">Contact Email</label>
      <input
        type="email"
        id="contact_email"
        name="contact_email"
        value="<%= data.contact_email || '' %>"
        required
        maxlength="255"
      >
    </div>

    <div>
      <label for="logo_filename">Logo Filename</label>
      <input
        type="text"
        id="logo_filename"
        name="logo_filename"
        value="<%= data.logo_filename || '' %>"
        required
        maxlength="255"
      >
    </div>

    <button type="submit">Update Organization</button>
  </form>

  <p>
    <a href="/organization/<%= data.organization_id %>">Cancel</a>
  </p>
</main>

<%- include("partials/footer") %>