<%- include("partials/header") %>

<h1><%= title %></h1>

<section class="categories">
    <% categories.forEach(category => { %>
        <div class="category-card">
            <h2>
                <a href="/category/<%= category.category_id %>">
                    <%= category.name %>
                </a>
            </h2>
        </div>
    <% }) %>
</section>

<%- include("partials/footer") %>