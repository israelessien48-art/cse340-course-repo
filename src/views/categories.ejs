<%- include("partials/header") %>

<main>
  <h1><%= title %></h1>

  <p>
    <a href="/new-category">Add Category</a>
  </p>

  <section class="categories">
    <% categories.forEach(category => { %>
      <div class="category-card">
        <h2>
          <a href="/category/<%= category.category_id %>">
            <%= category.name %>
          </a>
        </h2>
      </div>
    <% }) %>
  </section>
</main>

<%- include("partials/footer") %>