<%- include("partials/header") %>

<main>
  <h1><%= title %></h1>

  <p>
    Organizations working together to make a positive difference
    through meaningful service projects.
  </p>

  <p>
    <a href="/new-organization">Add Organization</a>
  </p>

  <section>
    <h2>Community Organizations</h2>

    <% organizations.forEach((organization) => { %>
      <article>
        <img
          src="/images/<%= organization.logo_filename %>"
          alt="<%= organization.name %> logo"
        >

        <h3>
          <a href="/organization/<%= organization.organization_id %>">
            <%= organization.name %>
          </a>
        </h3>

        <p><%= organization.description %></p>

        <p>
          <strong>Contact:</strong>
          <%= organization.contact_email %>
        </p>
      </article>
    <% }) %>
  </section>
</main>

<%- include("partials/footer") %>